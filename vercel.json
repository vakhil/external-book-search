{
  "version": 2,
  "functions": {
    "api/*.py": {
      "includeFiles": "bookstore.db,book_summaries_cache.json,initial_inventory.csv,sheets_config.json,google_config.json,*.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=/api/$1"
    }
  ]
}
